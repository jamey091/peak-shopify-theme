<section class="peak-hero">
  <div class="peak-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="peak-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    <h1 class="peak-hero__title">
      {{ section.settings.heading }}
    </h1>

    {% if section.settings.text != blank %}
      <p class="peak-hero__text">
        {{ section.settings.text }}
      </p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a
        class="peak-button"
        href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

  <div class="peak-hero__card">
    <p class="peak-hero__card-label">NEW DROP</p>
    <h2>Performance Series 01</h2>
  </div>
</section>

{% schema %}
{
  "name": "PEAK Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PEAK PERFORMANCE SPORTSWEAR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built to move. Designed to perform."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Performance apparel engineered for training, movement and everyday wear."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "PEAK Hero"
    }
  ]
}
{% endschema %}